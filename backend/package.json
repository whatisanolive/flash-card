{
  "name": "recall-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Recall flashcard app (Express + Prisma + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "db:studio": "prisma studio",
    "setup": "node -e \"const fs=require('fs'); fs.existsSync('.env') || fs.copyFileSync('.env.example', '.env')\" && prisma generate && prisma db push && node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
